---
import BaseLayout from "../layouts/BaseLayout.astro";
import { wrap, band, eyebrow, primaryBtn } from "../lib/styles";
---

<BaseLayout title="Page not found | Jorge Oliveira">
  <section class="flex flex-1 items-center border-b border-line">
    <div class={wrap}>
      <div class={`${band} flex flex-col items-center text-center`}>
        <div class={eyebrow}>ERROR · 404</div>
        <h1 class="text-h2 font-extrabold tracking-[-0.01em] text-ink">
          Page not found
        </h1>
        <p
          class="mt-5 max-w-130 font-sans text-body leading-[1.7] text-ink-dim"
        >
          That URL doesn't exist. The page might have moved. Head back to the
          homepage and start from the top.
        </p>
        <a class={`${primaryBtn} mt-7`} href="/">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
