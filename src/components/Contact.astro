---
import { profile } from "../data/profile";
import { wrap, band, sectionBase, eyebrow, focusRing, primaryBtn } from "../lib/styles";

const channels: Record<string, string> = {
  LinkedIn: "PRIMARY",
  GitHub: "CODE",
  "Twitter / X": "SOCIAL",
};
---

<section class={sectionBase} id="contact">
  <div class={wrap}>
    <div class={band} data-reveal="band">
      <div
        class="grid grid-cols-[1.1fr_0.9fr] items-end gap-15 max-[820px]:grid-cols-1"
      >
        <div data-reveal>
          <div class={eyebrow}>TRANSMIT</div>
          <h2
            class="text-h3 font-extrabold leading-[1.05] tracking-[-0.01em] text-ink"
          >
            Let's talk<span class="text-primary">.</span>
          </h2>
          <p class="mt-5 max-w-110 text-body text-ink-dim">
            Hiring, or have a project in mind? Message me on LinkedIn and I'll
            get back to you. Code and commit history are on GitHub if you want
            to look first.
          </p>
        </div>
        <div class="border border-line bg-surface p-8" data-reveal style="--d:180ms">
          {
            profile.socials.map((s) => (
              <div class="flex items-center justify-between border-b border-line py-4 last:border-b-0">
                <span class="font-mono text-meta tracking-[0.06em] text-dim">
                  {channels[s.label] ?? "SOCIAL"}
                </span>
                <a
                  class={`group flex items-center gap-2.5 font-mono text-ui text-ink transition hover:text-primary ${focusRing}`}
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                >
                  {s.label} <span class="text-primary transition-transform group-hover:translate-x-0.5">↗</span><span class="sr-only">(opens in a new tab)</span>
                </a>
              </div>
            ))
          }
          <div class="flex items-center justify-between border-b border-line py-4 last:border-b-0">
            <span class="font-mono text-meta tracking-[0.06em] text-dim">EMAIL</span>
            <a
              class={`group flex items-center gap-2.5 font-mono text-ui text-ink transition hover:text-primary ${focusRing}`}
              href={`mailto:${profile.email}`}
            >
              {profile.email}
            </a>
          </div>
          <a class={`${primaryBtn} mt-7`} href="#" target="_blank" rel="noopener" style="transform:none"
            >Let's talk. I'll reply within 24h. <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span></a
          >
        </div>
      </div>
    </div>
  </div>
</section>
