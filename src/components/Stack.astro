---
import { stack } from "../data/stack";
import { wrap, band, section, eyebrow, sectionHead, sectionTitle, sectionNote } from "../lib/styles";

const tagClass: Record<string, string> = {
  core: "text-good border-good",
  learning: "text-primary border-primary",
  alsoUsed: "text-dim border-line",
};

const shades = [
  "bg-[rgba(36,85,201,0.08)]",
  "bg-[rgba(36,85,201,0.15)]",
  "bg-[rgba(36,85,201,0.22)]",
  "bg-[rgba(36,85,201,0.29)]",
  "bg-[rgba(36,85,201,0.36)]",
  "bg-[rgba(36,85,201,0.43)]",
  "bg-[rgba(36,85,201,0.5)]",
  "bg-[rgba(36,85,201,0.57)]",
];

const starts: Record<string, number> = {};
let tileIndex = 0;
for (const group of stack) {
  starts[group.id] = tileIndex;
  tileIndex += group.items.length;
}
---

<section class={section} id="stack">
  <div class={wrap}>
    <div class={band} data-reveal="band">
      <div class={sectionHead} data-reveal>
        <div>
          <div class={eyebrow}>SPEC SHEET</div>
          <h2 class={sectionTitle}>Where things stand</h2>
        </div>
        <div class={sectionNote}>
          Status shown per skill. Not everything is at the same stage, and
          that's on purpose.
        </div>
      </div>

      {
        stack.map((group, gi) => (
          <div class="mb-10 last:mb-0">
            <div
              class="mb-3.5 flex items-center gap-3 font-mono text-label-sm text-ink-dim"
              data-reveal
              style={`--d:${gi * 120}ms`}
            >
              <span
                class={`border px-2.25 py-1 font-mono text-micro font-semibold tracking-[0.06em] ${tagClass[group.id]}`}
              >
                {group.tag}
              </span>
              {group.label}
            </div>
            {group.id === "alsoUsed" ? (
              <div class="flex flex-wrap gap-2">
                {group.items.map((item, i) => (
                  <span
                    class={`${shades[(starts[group.id] + i) % shades.length]} cursor-default border border-line px-3 py-2 font-mono text-ui-sm text-ink transition hover:bg-[#2455c9] hover:text-white`}
                    data-reveal
                    style={`--d:${i * 90}ms`}
                  >
                    {item}
                  </span>
                ))}
              </div>
            ) : (
              <div class="grid grid-cols-[repeat(auto-fill,minmax(9.375rem,1fr))] gap-px border border-line bg-line">
                {group.items.map((item, i) => (
                  <div
                    class={`${shades[(starts[group.id] + i) % shades.length]} cursor-default flex items-center justify-between p-4 font-mono text-ui-sm text-ink transition hover:bg-[#2455c9] hover:text-white`}
                    data-reveal="tile"
                    style={`--d:${i * 90}ms`}
                  >
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
