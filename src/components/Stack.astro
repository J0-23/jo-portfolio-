---
import { stack } from "../data/stack";
import { wrap, band, section, eyebrow, sectionHead, sectionTitle, sectionNote } from "../lib/styles";

const tagClass: Record<string, string> = {
  core: "text-good border-good",
  inProgress: "text-primary border-primary",
  learning: "text-warn border-warn",
  alsoUsed: "text-dim border-line",
};
---

<section class={section} id="stack">
  <div class={wrap}>
    <div class={band}>
      <div class={sectionHead}>
        <div>
          <div class={eyebrow}>SPEC SHEET</div>
          <h2 class={sectionTitle}>Where things stand</h2>
        </div>
        <div class={sectionNote}>
          Status shown per skill — not everything is at the same stage, and
          that's on purpose.
        </div>
      </div>

      {
        stack.map((group) => (
          <div class="mb-10 last:mb-0">
            <div class="mb-3.5 flex items-center gap-3 font-mono text-label-sm text-ink-dim">
              <span
                class={`border px-2.25 py-1 font-mono text-micro font-semibold tracking-[0.06em] ${tagClass[group.id]}`}
              >
                {group.tag}
              </span>
              {group.label}
            </div>
            {group.id === "alsoUsed" ? (
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="border border-line bg-surface px-3 py-2 font-mono text-label-sm text-ink-dim">
                    {item}
                  </span>
                ))}
              </div>
            ) : (
              <div class="grid grid-cols-[repeat(auto-fill,minmax(9.375rem,1fr))] gap-px border border-line bg-line">
                {group.items.map((item) => (
                  <div class="flex items-center justify-between bg-surface p-4 font-mono text-code text-ink-dim transition hover:bg-surface-2 hover:text-ink">
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
