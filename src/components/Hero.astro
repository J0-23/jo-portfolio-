---
import { profile } from "../data/profile";
import { stack } from "../data/stack";
import { wrap, band, eyebrow, primaryBtn, secondaryBtn } from "../lib/styles";

const core = stack.find((group) => group.id === "core")?.items ?? [];
const learning = [
  ...(stack.find((group) => group.id === "inProgress")?.items ?? []),
  ...(stack.find((group) => group.id === "learning")?.items ?? []),
];
const stackList = core.map((item) => `"${item}"`).join(",");
const learningList = learning.map((item) => `"${item}"`).join(",");
const fullTime = profile.status.toLowerCase().includes("full-time");
const freelance = profile.freelance;
const slug = profile.name.toLowerCase().replace(/\s+/g, "-");

const terminalKey = "text-dim";
const terminalVal = "text-ink";
---

<section
  id="profile"
  class="flex min-h-[92vh] items-center border-b border-line pt-27.5 pb-15 max-[820px]:pt-20 scroll-mt-22"
>
  <div class={wrap}>
    <div class={band}>
      <div
        class="grid w-full grid-cols-[1.2fr_0.8fr] items-center gap-17.5 max-[820px]:grid-cols-1"
      >
        <div>
          <div class={eyebrow}>SOFTWARE DEVELOPER</div>
          <h1
            class="text-h1 font-extrabold leading-none tracking-[-0.02em] text-ink"
          >
            Jorge<br />
            <span class="text-primary">Oliveira</span>
          </h1>
          <p class="mt-5.5 max-w-130 text-hero-sub leading-[1.65] text-ink-dim">
            {profile.intro}
          </p>
          <div class="mt-9 flex flex-wrap gap-3.5">
            <a class={primaryBtn} href="#contact">Get in touch →</a>
            <a class={secondaryBtn} href="#projects">See the work</a>
          </div>
        </div>
        <div
          aria-hidden="true"
          class="border border-line bg-surface shadow-[0_1.25rem_3.125rem_rgba(20,24,29,0.05)]"
        >
          <div
            class="flex items-center justify-between border-b border-line px-4 py-3"
          >
            <div class="flex gap-1.5">
              <span class="h-2 w-2 rounded-full bg-line"></span>
              <span class="h-2 w-2 rounded-full bg-line"></span>
              <span class="h-2 w-2 rounded-full bg-line"></span>
            </div>
            <div class="font-mono text-micro tracking-[0.04em] text-dim">
              status.sh
            </div>
          </div>
          <div class="px-5 py-5.5 font-mono text-code leading-loose">
            <div>
              <span class={terminalKey}>$</span>
              <span class={terminalVal}>whoami</span>
            </div>
            <div class={terminalVal}>{slug} — full-stack dev</div>
            <div class="h-3.5"></div>
            <div>
              <span class={terminalKey}>$</span>
              <span class={terminalVal}>cat status.json</span>
            </div>
            <div>
              <span class={terminalKey}>location:</span>
              <span class={terminalVal}>"{profile.location}"</span>
            </div>
            <div>
              <span class={terminalKey}>experience:</span>
              <span class={terminalVal}>"{profile.experience}"</span>
            </div>
            <div>
              <span class={terminalKey}>stack:</span>
              <span class={terminalVal}>[{stackList}]</span>
            </div>
            <div>
              <span class={terminalKey}>learning:</span>
              <span class="text-primary">[{learningList}]</span>
            </div>
            <div>
              <span class={terminalKey}>full_time:</span>
              <span class={fullTime ? "font-semibold text-good" : terminalVal}>
                {fullTime}
              </span>
            </div>
            <div>
              <span class={terminalKey}>freelance:</span>
              <span class={freelance ? "font-semibold text-good" : terminalVal}>
                {freelance}
              </span>
            </div>
            <div class="h-3.5"></div>
            <div>
              <span class={terminalKey}>$</span>
              <span
                class="inline-block h-3.5 w-1.75 animate-blink bg-primary align-middle motion-reduce:animate-none"
              ></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
